      "isDeleted": false,
      "boundElements": [],
      "updated": 1779809540346,
      "link": null,
      "locked": false,
      "text": "mergeTwoSortedArrays(A, B):\n    \n    N = A.size()\n    M = B.size()\n\n    C = []\n\n    i = 0\n    j = 0\n    \n    while i < N and j < M:\n        if A[i] <= B[j]:\n            C.push_back(A[i])\n            i++\n        else:\n            C.push_back(B[j])\n            j++\n\n    while i < N:\n        C.push_back(A[i])\n        i++\n\n    while j < M:\n        C.push_back(B[j])\n        j++\n    \n    return C",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "mergeTwoSortedArrays(A, B):\n    \n    N = A.size()\n    M = B.size()\n\n    C = []\n\n    i = 0\n    j = 0\n    \n    while i < N and j < M:\n        if A[i] <= B[j]:\n            C.push_back(A[i])\n            i++\n        else:\n            C.push_back(B[j])\n            j++\n\n    while i < N:\n        C.push_back(A[i])\n        i++\n\n    while j < M:\n        C.push_back(B[j])\n        j++\n    \n    return C",
      "autoResize": true,
      "lineHeight": 1.25
    },
