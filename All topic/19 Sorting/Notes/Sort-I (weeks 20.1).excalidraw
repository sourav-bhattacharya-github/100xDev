      "groupIds": [],
      "frameId": null,
      "index": "b7l",
      "roundness": null,
      "seed": 1869304305,
      "version": 224,
      "versionNonce": 1179681745,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779810237280,
      "link": null,
      "locked": false,
      "text": "f(A, l, r):\n    \n    if  l == r:\n        return   \n\n    mid = (l + r) / 2\n\n    // sort first half\n    f(A, l, mid)\n    \n    // sort second half\n    f(A, mid + 1, r)\n\n    merge(A, l, r)\n    \n ",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(A, l, r):\n    \n    if  l == r:\n        return   \n\n    mid = (l + r) / 2\n\n    // sort first half\n    f(A, l, mid)\n    \n    // sort second half\n    f(A, mid + 1, r)\n\n    merge(A, l, r)\n    \n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
