      "type": "text",
      "x": 500687.0047297648,
      "y": 5535.8807889745385,
      "width": 455.39971923828125,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
