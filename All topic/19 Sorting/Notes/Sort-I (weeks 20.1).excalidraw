    {
      "id": "ZwiGRrq4XfH9HAJWIQObf",
      "type": "text",
      "x": 512421.27996986115,
      "y": 5899.095858201155,
      "width": 954.7997436523438,
      "height": 2310,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bA3",
      "roundness": null,
      "seed": 459157201,
      "version": 1069,
      "versionNonce": 1377331615,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779815266637,
      "link": null,
      "locked": false,
      "text": "int merge(int A[], int l, int r)\n{\n    // first half => [l, mid]\n\n    // second half => [mid + 1, r]\n    \n    ans = 0\n\n    i = l\n    j = mid + 1\n\n    vector<int> temp;\n\n    while i <= mid and j <= r:\n        if A[i] <= A[j]:\n            temp.push_back(A[i])\n            i++\n        else:\n            // [i, mid]\n            ans += mid - i + 1\n            temp.push_back(A[j])\n            j++\n   \n    while i <= mid:\n            temp.push_back(A[i])\n            i++\n\n    while j <= r:\n            temp.push_back(A[j])\n            j++\n    \n    // copy to the temp array\n\n    return ans\n\n}\n\n\n\n\n\n\nint f(int A[], int l, int r)\n{\n    if(l == r) return 0;\n\n    int mid = (l + r) / 2;\n\n    // sort the first half and bring back the inversions\n    ans1 = f(A, l, mid)\n\n    // sort the second half and bring back the inversions\n    ans2 = f(A, mid + 1, r)\n\n    // merge these 2 sorted array and count the rem inversions\n    ans3 = merge(A, l, r)\n\n    return ans1 + ans2 + ans3;\n}\n\nmain():\n    N = input()\n\n    A = input()\n\n    print(f(A, 0, N - 1)",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int merge(int A[], int l, int r)\n{\n    // first half => [l, mid]\n\n    // second half => [mid + 1, r]\n    \n    ans = 0\n\n    i = l\n    j = mid + 1\n\n    vector<int> temp;\n\n    while i <= mid and j <= r:\n        if A[i] <= A[j]:\n            temp.push_back(A[i])\n            i++\n        else:\n            // [i, mid]\n            ans += mid - i + 1\n            temp.push_back(A[j])\n            j++\n   \n    while i <= mid:\n            temp.push_back(A[i])\n            i++\n\n    while j <= r:\n            temp.push_back(A[j])\n            j++\n    \n    // copy to the temp array\n\n    return ans\n\n}\n\n\n\n\n\n\nint f(int A[], int l, int r)\n{\n    if(l == r) return 0;\n\n    int mid = (l + r) / 2;\n\n    // sort the first half and bring back the inversions\n    ans1 = f(A, l, mid)\n\n    // sort the second half and bring back the inversions\n    ans2 = f(A, mid + 1, r)\n\n    // merge these 2 sorted array and count the rem inversions\n    ans3 = merge(A, l, r)\n\n    return ans1 + ans2 + ans3;\n}\n\nmain():\n    N = input()\n\n    A = input()\n\n    print(f(A, 0, N - 1)",
      "autoResize": true,
      "lineHeight": 1.25
    },
