    {
      "id": "x3v69l8ai4AcM16bz65gO",
      "type": "text",
      "x": 525570.9685822612,
      "y": 5169.03898481668,
      "width": 574.1996459960938,
      "height": 585,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4B",
      "roundness": null,
      "seed": 990146204,
      "version": 200,
      "versionNonce": 187143708,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779988653514,
      "link": null,
      "locked": false,
      "text": "f(A, l, r):\n\n    if l == r:\n        return 0\n    \n    mid = (l + r) / 2\n    \n    ans1 = f(A, l, mid)\n    ans2 = f(A, mid + 1, r)\n\n    ans3 = merge(A, l, r)\n\n    return ans1 + ans2 + ans3",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(A, l, r):\n\n    if l == r:\n        return 0\n    \n    mid = (l + r) / 2\n    \n    ans1 = f(A, l, mid)\n    ans2 = f(A, mid + 1, r)\n\n    ans3 = merge(A, l, r)\n\n    return ans1 + ans2 + ans3",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vc9S8VzVUYDUeUqPaPjdA",
      "type": "text",
      "x": 526138.2745989182,
      "y": 4963.111942006626,
      "width": 514.7996826171875,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4C",
      "roundness": null,
      "seed": 1947198236,
      "version": 173,
      "versionNonce": 1944268444,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779988727618,
      "link": null,
      "locked": false,
      "text": "merge(A, l, r):\n\n    mid = (l + r) / 2\n\n    // counting part\n\n\n    // merge logic\n    i = l\n    j = mid + 1\n\n     .\n    .\n    .\n     \n    // copy from temp to A",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "merge(A, l, r):\n\n    mid = (l + r) / 2\n\n    // counting part\n\n\n    // merge logic\n    i = l\n    j = mid + 1\n\n     .\n    .\n    .\n     \n    // copy from temp to A",
      "autoResize": true,
      "lineHeight": 1.25
    },
