      "text": "bool cmp(string a, string b) {\n\n    int lengthA = a.size();\n    int lengthB = b.size();\n\n    if(lengthA != lengthB) {\n        return lengthA < lengthB;\n    }\n\n    return a < b;\n}",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool cmp(string a, string b) {\n\n    int lengthA = a.size();\n    int lengthB = b.size();\n\n    if(lengthA != lengthB) {\n        return lengthA < lengthB;\n    }\n\n    return a < b;\n}",
      "autoResize": true,
      "lineHeight": 1.25
