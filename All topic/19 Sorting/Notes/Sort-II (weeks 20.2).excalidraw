      "link": null,
      "locked": false,
      "text": "int freq[101] = { 0 };\n\nfor(i = 0; i < N; i++)\n{\n    freq[A[i] + 50]++;\n}\n\nfor(i = 0; i < 101; i++)\n{\n    for(j = 1; j <= freq[i]; j++)\n    {\n        cout << i - 50 << \" \";\n    }\n}",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int freq[101] = { 0 };\n\nfor(i = 0; i < N; i++)\n{\n    freq[A[i] + 50]++;\n}\n\nfor(i = 0; i < 101; i++)\n{\n    for(j = 1; j <= freq[i]; j++)\n    {\n        cout << i - 50 << \" \";\n    }\n}",
