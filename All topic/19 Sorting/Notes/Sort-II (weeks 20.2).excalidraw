      "seed": 1141849124,
      "version": 151,
      "versionNonce": 79702940,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779984419208,
      "link": null,
      "locked": false,
      "text": "bool cmp(int a, int b)\n{\n    int lastDigitA = a % 10;\n    int lastDigitB = b % 10;\n\n    if(lastDigitA < lastDigitB)\n    {\n        return true;\n    }\n\n    return false\n}",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool cmp(int a, int b)\n{\n    int lastDigitA = a % 10;\n    int lastDigitB = b % 10;\n\n    if(lastDigitA < lastDigitB)\n    {\n        return true;\n    }\n\n    return false\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
