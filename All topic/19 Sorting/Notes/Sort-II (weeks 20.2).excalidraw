      "isDeleted": false,
      "boundElements": [],
      "updated": 1779987587834,
      "link": null,
      "locked": false,
      "text": "Comparator<Integer> -> (a, b)\n{\n    if(a < b)\n    {\n        return -1;\n    }\n\n    if(a == b)\n    {\n        return 0;\n    }\n\n    return 1;\n\n};",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Comparator<Integer> -> (a, b)\n{\n    if(a < b)\n    {\n        return -1;\n    }\n\n    if(a == b)\n    {\n        return 0;\n    }\n\n    return 1;\n\n};",
      "autoResize": true,
      "lineHeight": 1.25
    },
