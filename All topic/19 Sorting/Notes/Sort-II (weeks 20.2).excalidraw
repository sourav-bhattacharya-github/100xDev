      "updated": 1779981794584,
      "link": null,
      "locked": false,
      "text": "count_sort(A):\n\n    int freq[10] = {0};\n\n    for(i = 0; i < N; i++)\n    {\n        freq[A[i]]++;\n    }\n\n    for(i = 0; i < 10; i++)\n    {\n        for(j = 1; j <= freq[i]; j++)\n        {\n            cout << i << \" \";\n        }\n    }",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "count_sort(A):\n\n    int freq[10] = {0};\n\n    for(i = 0; i < N; i++)\n    {\n        freq[A[i]]++;\n    }\n\n    for(i = 0; i < 10; i++)\n    {\n        for(j = 1; j <= freq[i]; j++)\n        {\n            cout << i << \" \";\n        }\n    }",
      "autoResize": true,
      "lineHeight": 1.25
    },
