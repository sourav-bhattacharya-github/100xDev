      "isDeleted": false,
      "boundElements": [],
      "updated": 1779989290942,
      "link": null,
      "locked": false,
      "text": "i = l\nj = mid + 1\n\nwhile i <= mid and j <= r:\n    if A[i] <= 2 * A[j]:\n        i++\n    else:\n        ans += mid - i + 1\n        j++",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "i = l\nj = mid + 1\n\nwhile i <= mid and j <= r:\n    if A[i] <= 2 * A[j]:\n        i++\n    else:\n        ans += mid - i + 1\n        j++",
      "autoResize": true,
      "lineHeight": 1.25
    }
