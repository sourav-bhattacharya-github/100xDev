      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Desc b - a\n\nAsc a - b",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hkAEb8lX_A1vR52G3YSte",
      "type": "text",
      "x": 518288.5600136969,
      "y": 5787.283341386323,
      "width": 930.5994262695312,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3M",
      "roundness": null,
      "seed": 1177167524,
      "version": 87,
      "versionNonce": 737935004,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779987655117,
      "link": null,
      "locked": false,
      "text": "int cmp(Student a, Student b) {\n    \n    if(a.totalMarks != b.totalMarks) {\n        return b.totalMarks - a.totalMarks;\n    }\n    \n    if(a.mathMarks != b.mathMarks) {\n        return b.mathMarks - a.mathMarks;\n    }\n    \n    if(a.physicsMarks != b.physicsMarks) {\n        return b.physicsMarks - a.physicsMarks;\n    }\n    \n    return a.name - b.name;\n}",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int cmp(Student a, Student b) {\n    \n    if(a.totalMarks != b.totalMarks) {\n        return b.totalMarks - a.totalMarks;\n    }\n    \n    if(a.mathMarks != b.mathMarks) {\n        return b.mathMarks - a.mathMarks;\n    }\n    \n    if(a.physicsMarks != b.physicsMarks) {\n        return b.physicsMarks - a.physicsMarks;\n    }\n    \n    return a.name - b.name;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
