    {
      "id": "AM4d5debSA24L4RG3uTwd",
      "type": "text",
      "x": 517311.93933137355,
      "y": 5820.791699305426,
      "width": 930.5994262695312,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3C",
      "roundness": null,
      "seed": 1611150876,
      "version": 3,
      "versionNonce": 1477336860,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779987410120,
      "link": null,
      "locked": false,
      "text": "bool cmp(Student a, Student b) {\n    \n    if(a.totalMarks != b.totalMarks) {\n        return a.totalMarks > b.totalMarks;\n    }\n    \n    if(a.mathMarks != b.mathMarks) {\n        return a.mathMarks > b.mathMarks;\n    }\n    \n    if(a.physicsMarks != b.physicsMarks) {\n        return a.physicsMarks > b.physicsMarks;\n    }\n    \n    return a.name < b.name;\n}",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool cmp(Student a, Student b) {\n    \n    if(a.totalMarks != b.totalMarks) {\n        return a.totalMarks > b.totalMarks;\n    }\n    \n    if(a.mathMarks != b.mathMarks) {\n        return a.mathMarks > b.mathMarks;\n    }\n    \n    if(a.physicsMarks != b.physicsMarks) {\n        return a.physicsMarks > b.physicsMarks;\n    }\n    \n    return a.name < b.name;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
