      "seed": 2060463012,
      "version": 223,
      "versionNonce": 1880690076,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779982497048,
      "link": null,
      "locked": false,
      "text": "int freq[26] = {0};\n\nfor(i = 0; i < N; i++)\n{\n    freq[s[i] - 'a']++;\n}\n\nfor(i = 0; i < 26; i++)\n{\n    for(j = 1; j <= freq[i]; j++)\n    {\n        cout << char(i + 'a');\n    }\n}",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int freq[26] = {0};\n\nfor(i = 0; i < N; i++)\n{\n    freq[s[i] - 'a']++;\n}\n\nfor(i = 0; i < 26; i++)\n{\n    for(j = 1; j <= freq[i]; j++)\n    {\n        cout << char(i + 'a');\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
