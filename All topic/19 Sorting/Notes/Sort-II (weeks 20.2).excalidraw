    {
      "id": "e3O4S4GciTFXFP15AP3Cc",
      "type": "text",
      "x": 500512.83747140516,
      "y": 4853.825725568387,
      "width": 653.3995971679688,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
