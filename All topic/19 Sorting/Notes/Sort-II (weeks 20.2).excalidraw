      "seed": 251287068,
      "version": 239,
      "versionNonce": 758367004,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779987808888,
      "link": null,
      "locked": false,
      "text": "Given an array of integers (0 - 10^9)\n\nconcat all the numbers of the array to form a number\nand the goal is to make the largest number possible.\n\nWe are allowed to rearrange the data",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Given an array of integers (0 - 10^9)\n\nconcat all the numbers of the array to form a number\nand the goal is to make the largest number possible.\n\nWe are allowed to rearrange the data",
      "autoResize": true,
      "lineHeight": 1.25
    },
