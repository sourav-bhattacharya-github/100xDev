    {
      "id": "z3okdLDVuctviX142ySPQ",
      "type": "text",
      "x": 478876.02831076895,
      "y": 3986.507565266304,
      "width": 646.7997436523438,
      "height": 1330,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aU",
      "roundness": null,
      "seed": 762741537,
      "version": 531,
      "versionNonce": 954481601,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779376935198,
      "link": null,
      "locked": false,
      "text": "f(i, j):\n    \n    // out of the grid\n    if i < 0 or j < 0 or i == N or j == M:\n        return \n\n    \n\n\n\n  \n    \n    // reached the dest\n    if i == N - 1 and j == M - 1:\n        print(path)\n        return\n\n    \n\n    // down\n    path.push_back(\"D\");\n    f(i + 1, j)\n    path.pop_back()\n\n    // up\n    path.push_back(\"U\");\n    f(i - 1, j)\n    path.pop_back()\n\n    // right\n    path.push_back(\"R\")\n    f(i, j + 1)\n    path.pop_back()\n\n    // left\n    path.push_back(\"L\");\n    f(i, j - 1)\n    path.pop_back()",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(i, j):\n    \n    // out of the grid\n    if i < 0 or j < 0 or i == N or j == M:\n        return \n\n    \n\n\n\n  \n    \n    // reached the dest\n    if i == N - 1 and j == M - 1:\n        print(path)\n        return\n\n    \n\n    // down\n    path.push_back(\"D\");\n    f(i + 1, j)\n    path.pop_back()\n\n    // up\n    path.push_back(\"U\");\n    f(i - 1, j)\n    path.pop_back()\n\n    // right\n    path.push_back(\"R\")\n    f(i, j + 1)\n    path.pop_back()\n\n    // left\n    path.push_back(\"L\");\n    f(i, j - 1)\n    path.pop_back()",
      "autoResize": true,
      "lineHeight": 1.25
    },
