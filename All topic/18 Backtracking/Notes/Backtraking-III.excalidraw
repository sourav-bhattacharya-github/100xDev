      "text": "f(A, Used, path):\n    \n    if path.size() == A.size():\n        print(path)\n        return\n\n    for i = 0; i < N; i++:\n        if !used[i]:\n            path.push_back(arr[i])\n            used[i] = true\n\n            f(A, used, path)\n            \n            used[i] = false\n            path.pop_back()\n            ",
