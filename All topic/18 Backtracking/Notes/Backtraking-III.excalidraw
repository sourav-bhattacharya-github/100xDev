    {
      "id": "zUzIfu_QtygUSrfwKjnps",
      "type": "text",
      "x": 485995.3649899822,
      "y": 3519.7076942128206,
      "width": 461.99981689453125,
      "height": 945,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3i",
      "roundness": null,
      "seed": 115662145,
      "version": 559,
      "versionNonce": 1998311937,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779379958286,
      "link": null,
      "locked": false,
      "text": "bool canPlace(r, c, board):\n      \n    // same column\n    i = r, j = c\n    while i >= 0:\n        if board[i][j] == 'Q':\n            return false\n        i--    \n    \n    // diag 1\n     i = r, j = c\n     while i >= 0 and j >= 0:\n        if board[i][j] == 'Q':\n            return false\n        i--    \n        j--\n\n\n    // diag 2\n     i = r, j = c\n     while i >= 0 and j < N:\n        if board[i][j] == 'Q':\n            return false\n        i--    \n        j++\n\n    return true",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool canPlace(r, c, board):\n      \n    // same column\n    i = r, j = c\n    while i >= 0:\n        if board[i][j] == 'Q':\n            return false\n        i--    \n    \n    // diag 1\n     i = r, j = c\n     while i >= 0 and j >= 0:\n        if board[i][j] == 'Q':\n            return false\n        i--    \n        j--\n\n\n    // diag 2\n     i = r, j = c\n     while i >= 0 and j < N:\n        if board[i][j] == 'Q':\n            return false\n        i--    \n        j++\n\n    return true",
      "autoResize": true,
      "lineHeight": 1.25
    },
