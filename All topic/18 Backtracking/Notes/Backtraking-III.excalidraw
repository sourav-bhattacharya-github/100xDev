    {
      "id": "gEklg4jyZy00iLZCDWypH",
      "type": "text",
      "x": 489809.4230922183,
      "y": 3735.6357449797893,
      "width": 692.999755859375,
      "height": 805,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4D",
      "roundness": null,
      "seed": 1279695233,
      "version": 388,
      "versionNonce": 1868777967,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779382257447,
      "link": null,
      "locked": false,
      "text": "bool canPlace(r, c, val, board):\n\n    // same row\n    for j = 0; j < N; j++    \n        if board[r][j] == val:\n            return false\n    \n\n    // same col\n    for i = 0; i < N; i++    \n        if board[i][c] == val:\n            return false\n\n    // same box\n    sr = (r / 3) * 3\n    sc = (c / 3) * 3\n    \n    for i = 0; i < 3; i++\n        for j = 0; j < 3; j++\n            if(board[sr + i][sc + j] == val):\n                return false\n    \n    return true",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "bool canPlace(r, c, val, board):\n\n    // same row\n    for j = 0; j < N; j++    \n        if board[r][j] == val:\n            return false\n    \n\n    // same col\n    for i = 0; i < N; i++    \n        if board[i][c] == val:\n            return false\n\n    // same box\n    sr = (r / 3) * 3\n    sc = (c / 3) * 3\n    \n    for i = 0; i < 3; i++\n        for j = 0; j < 3; j++\n            if(board[sr + i][sc + j] == val):\n                return false\n    \n    return true",
      "autoResize": true,
      "lineHeight": 1.25
    },
