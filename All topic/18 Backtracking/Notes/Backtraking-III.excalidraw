      "boundElements": [],
      "updated": 1779379867520,
      "link": null,
      "locked": false,
      "text": "f(i, board):\n      \n    if i == N:\n        print(board)\n        return\n\n    for j = 0; j < N; j++\n        if canPlace(i, j, board):\n           board[i][j] = 'Q';\n           f(i + 1, board);\n           board[i][j] = '.';",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(i, board):\n      \n    if i == N:\n        print(board)\n        return\n\n    for j = 0; j < N; j++\n        if canPlace(i, j, board):\n           board[i][j] = 'Q';\n           f(i + 1, board);\n           board[i][j] = '.';",
      "autoResize": true,
      "lineHeight": 1.25
    },
