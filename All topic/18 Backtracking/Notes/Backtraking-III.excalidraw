    {
      "id": "AFhyA7pMVq__zdcOcYhoq",
      "type": "text",
      "x": 489959.808640701,
      "y": 4781.029578745819,
      "width": 569.7998046875,
      "height": 805,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5I",
      "roundness": null,
      "seed": 1482034817,
      "version": 573,
      "versionNonce": 1356408047,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779382601082,
      "link": null,
      "locked": false,
      "text": "f(i, j, board):\n    \n    if i == N:\n        return true\n\n    if j == M:\n         return f(i + 1, 0)\n\n    if board[i][j] != '.':\n        return f(i, j + 1)\n    \n    // try placing a digit here (1-9)\n\n    for val = 1; val <= 9; val++\n       if canPlace(i, j, val):\n          board[i][j] = val\n          bool ans = f(i, j + 1)\n          if ans == true:\n            return true\n          board[i][j] = '.'\n\n    return false\n        ",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(i, j, board):\n    \n    if i == N:\n        return true\n\n    if j == M:\n         return f(i + 1, 0)\n\n    if board[i][j] != '.':\n        return f(i, j + 1)\n    \n    // try placing a digit here (1-9)\n\n    for val = 1; val <= 9; val++\n       if canPlace(i, j, val):\n          board[i][j] = val\n          bool ans = f(i, j + 1)\n          if ans == true:\n            return true\n          board[i][j] = '.'\n\n    return false\n        ",
      "autoResize": true,
      "lineHeight": 1.25
    },
