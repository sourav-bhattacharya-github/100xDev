    {
      "id": "ILXchu3KWycTEYNixOM_W",
      "type": "text",
      "x": 488025.4816144362,
      "y": 3765.122940442082,
      "width": 711.4983251954969,
      "height": 177.09010686566342,
      "angle": 0,
