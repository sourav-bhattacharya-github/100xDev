    {
      "id": "c-c1Io9G7JoRC4qZdXdso",
      "type": "text",
      "x": 477138.15420004155,
      "y": 3902.029857283343,
      "width": 508.1997985839844,
      "height": 700,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 1257590927,
      "version": 316,
      "versionNonce": 1360169601,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779376170002,
      "link": null,
      "locked": false,
      "text": "f(i, j):\n    \n    // out of the grid\n    if i == N or j == M:\n        return   \n    \n    // reached the dest\n    if i == N - 1 and j == M - 1:\n        print(path)\n        return\n\n    // down\n    path.push_back(\"D\");\n    f(i + 1, j)\n    path.pop_back()\n\n    // right\n    path.push_back(\"R\")\n    f(i, j + 1)\n    path.pop_back()",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(i, j):\n    \n    // out of the grid\n    if i == N or j == M:\n        return   \n    \n    // reached the dest\n    if i == N - 1 and j == M - 1:\n        print(path)\n        return\n\n    // down\n    path.push_back(\"D\");\n    f(i + 1, j)\n    path.pop_back()\n\n    // right\n    path.push_back(\"R\")\n    f(i, j + 1)\n    path.pop_back()",
      "autoResize": true,
      "lineHeight": 1.25
    },
