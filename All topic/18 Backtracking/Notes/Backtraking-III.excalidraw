    {
      "id": "1C1iIRfjFviZTW0lTUJJd",
      "type": "text",
      "x": 488917.22694188287,
      "y": 3746.427342529653,
      "width": 631.3997802734375,
      "height": 735,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3y",
      "roundness": null,
      "seed": 295603471,
      "version": 387,
      "versionNonce": 1996491695,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779382470562,
      "link": null,
      "locked": false,
      "text": "f(i, j, board):\n    \n    if i == N:\n        print(board)\n        return    \n\n    if j == M:\n        f(i + 1, 0)\n        return\n\n    if board[i][j] != '.':\n        f(i, j + 1)\n    else:\n        // try placing a digit here (1-9)\n\n        for val = 1; val <= 9; val++\n          if canPlace(i, j, val):\n             board[i][j] = val\n             f(i, j + 1)\n             board[i][j] = '.'\n        ",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(i, j, board):\n    \n    if i == N:\n        print(board)\n        return    \n\n    if j == M:\n        f(i + 1, 0)\n        return\n\n    if board[i][j] != '.':\n        f(i, j + 1)\n    else:\n        // try placing a digit here (1-9)\n\n        for val = 1; val <= 9; val++\n          if canPlace(i, j, val):\n             board[i][j] = val\n             f(i, j + 1)\n             board[i][j] = '.'\n        ",
      "autoResize": true,
      "lineHeight": 1.25
    },
