    {
      "id": "q6mFyiOQ9p6UZghYjjLVr",
      "type": "text",
      "x": 407897.12012185267,
      "y": 214.46212646266702,
      "width": 431.1998291015625,
      "height": 70,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#13171b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bT6",
      "roundness": null,
      "seed": 881955347,
      "version": 41,
      "versionNonce": 500695827,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778602573949,
      "link": null,
      "locked": false,
      "text": "How can print all subarrays?\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How can print all subarrays?\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "l8Xe6Cj1bDdszbmYSzu-r",
      "type": "text",
      "x": 407931.8525949785,
      "y": 275.2439544327276,
      "width": 877.7996826171875,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#13171b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bT7",
      "roundness": null,
      "seed": 1367393907,
      "version": 250,
      "versionNonce": 1857424285,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778602677362,
      "link": null,
      "locked": false,
      "text": "Every subarray can be denoted [L, R] / [startIdx, endIdx]\n\nfor(l = 0; l < N; l++)\n{\n    for(r = l; r < N; r++)\n    {\n        // [l, r] has been decided\n        => this will be your subarray\n        print(A, l, r);\n    }\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every subarray can be denoted [L, R] / [startIdx, endIdx]\n\nfor(l = 0; l < N; l++)\n{\n    for(r = l; r < N; r++)\n    {\n        // [l, r] has been decided\n        => this will be your subarray\n        print(A, l, r);\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
