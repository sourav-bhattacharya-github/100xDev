      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bSM",
      "roundness": null,
      "seed": 1007915763,
      "version": 611,
      "versionNonce": 494453501,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778602071511,
      "link": null,
      "locked": false,
      "text": "f(i, j, N, M, path)\n{\n\n    // outside the grid / blocked\n    if i >= N or j >= M or (i, j) is Blocked:\n        return\n    \n    if i == N - 1 and j == M - 1:\n        // print the path\n        return\n    \n    // right\n    path.push_back(\"R\")\n    f(i, j + 1, N, M, path);\n    path.pop_back();\n\n    // Down\n    path.push_back(\"D\");\n    f(i + 1, j, N, M, path);\n    path.pop_back();\n} \n\n\n\n\n\nmain()\n{\n    path = []\n\n    N, M = input()\n\n    f(0, 0, N, M, path);\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(i, j, N, M, path)\n{\n\n    // outside the grid / blocked\n    if i >= N or j >= M or (i, j) is Blocked:\n        return\n    \n    if i == N - 1 and j == M - 1:\n        // print the path\n        return\n    \n    // right\n    path.push_back(\"R\")\n    f(i, j + 1, N, M, path);\n    path.pop_back();\n\n    // Down\n    path.push_back(\"D\");\n    f(i + 1, j, N, M, path);\n    path.pop_back();\n} \n\n\n\n\n\nmain()\n{\n    path = []\n\n    N, M = input()\n\n    f(0, 0, N, M, path);\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
