    {
      "id": "SqA1ePvwHiaZmN3qO1Hk1",
      "type": "text",
      "x": 401420.3431191483,
      "y": 297.5413366218662,
      "width": 446.5998229980469,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#13171b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bRg",
      "roundness": null,
      "seed": 378383315,
      "version": 155,
      "versionNonce": 1722247901,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778601273359,
      "link": null,
      "locked": false,
      "text": "// reached the destination\nif i == N - 1 and j == M - 1:\n    // print path\n    return\n\n// outside the grid\nif i >= N or j >= M:\n    return",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// reached the destination\nif i == N - 1 and j == M - 1:\n    // print path\n    return\n\n// outside the grid\nif i >= N or j >= M:\n    return",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "URH2eDW7GFz0ffm0ww79n",
      "type": "text",
      "x": 402249.2851264677,
      "y": 477.42270102255316,
      "width": 508.1997985839844,
      "height": 1190,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#13171b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bRh",
      "roundness": null,
      "seed": 2113549341,
      "version": 472,
      "versionNonce": 2051657405,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778602060630,
      "link": null,
      "locked": false,
      "text": "f(i, j, N, M, path)\n{\n    // outside the grid\n    if i >= N or j >= M:\n        return\n     \n    if i == N - 1 and j == M - 1:\n        // print the path\n        return\n    \n\n    // right\n    path.push_back(\"R\")\n    f(i, j + 1, N, M, path);\n    path.pop_back();\n\n    // Down\n    path.push_back(\"D\");\n    f(i + 1, j, N, M, path);\n    path.pop_back();\n} \n\n\n\n\n\nmain()\n{\n    path = []\n\n    N, M = input()\n\n    f(0, 0, N, M, path);\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(i, j, N, M, path)\n{\n    // outside the grid\n    if i >= N or j >= M:\n        return\n     \n    if i == N - 1 and j == M - 1:\n        // print the path\n        return\n    \n\n    // right\n    path.push_back(\"R\")\n    f(i, j + 1, N, M, path);\n    path.pop_back();\n\n    // Down\n    path.push_back(\"D\");\n    f(i + 1, j, N, M, path);\n    path.pop_back();\n} \n\n\n\n\n\nmain()\n{\n    path = []\n\n    N, M = input()\n\n    f(0, 0, N, M, path);\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
