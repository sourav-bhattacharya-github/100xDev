    {
      "id": "XemesQ-lBouzvHJorf2kL",
      "type": "text",
      "x": 394681.347712968,
      "y": -200.68586438423404,
      "width": 631.3997192382812,
      "height": 1155,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#13171b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bPI",
      "roundness": null,
      "seed": 835670909,
      "version": 367,
      "versionNonce": 1192172787,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778599645423,
      "link": null,
      "locked": false,
      "text": "void f(int cur, int N, vector<int> &path)\n{\n    if(cur == N)\n    {\n        // print the path\n        return;\n    }\n\n    if(cur > N)\n    {\n        return;\n    }\n    \n    // jump 1\n    path.push_back(1);\n    f(cur + 1, N); \n    path.pop_back();\n\n    // jump 2\n    path.push_back(2);\n    f(cur + 2, N);\n    path.pop_back();\n\n}\n\n\nmain()\n{\n    N = input();\n    path = []\n\n    f(0, N, path);\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void f(int cur, int N, vector<int> &path)\n{\n    if(cur == N)\n    {\n        // print the path\n        return;\n    }\n\n    if(cur > N)\n    {\n        return;\n    }\n    \n    // jump 1\n    path.push_back(1);\n    f(cur + 1, N); \n    path.pop_back();\n\n    // jump 2\n    path.push_back(2);\n    f(cur + 2, N);\n    path.pop_back();\n\n}\n\n\nmain()\n{\n    N = input();\n    path = []\n\n    f(0, N, path);\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
