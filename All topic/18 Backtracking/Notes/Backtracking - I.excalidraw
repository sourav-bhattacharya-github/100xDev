      "isDeleted": false,
      "boundElements": [],
      "updated": 1778604722925,
      "link": null,
      "locked": false,
      "text": "f(idx, sum, arr, path, K)\n{\n    if idx == arr.length:\n        if sum == K:\n            // print path\n        return    \n\n    // Take\n    path.push_back(arr[idx]);\n    f(idx + 1, sum + arr[idx], arr, path, K);\n    path.pop_back();   \n\n    // Not take\n    f(idx + 1, sum, arr, path);\n}\n\n\nmain()\n{\n    N, Arr, K = input()\n    \n    path = []    \n\n    f(0, 0, Arr, path, K)\n}\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(idx, sum, arr, path, K)\n{\n    if idx == arr.length:\n        if sum == K:\n            // print path\n        return    \n\n    // Take\n    path.push_back(arr[idx]);\n    f(idx + 1, sum + arr[idx], arr, path, K);\n    path.pop_back();   \n\n    // Not take\n    f(idx + 1, sum, arr, path);\n}\n\n\nmain()\n{\n    N, Arr, K = input()\n    \n    path = []    \n\n    f(0, 0, Arr, path, K)\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
