    {
      "id": "H7akXSX7_cUzgmKRmnLnh",
      "type": "text",
      "x": 413079.2227948954,
      "y": 381.9999784142575,
      "width": 692.999755859375,
      "height": 910,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#13171b",
