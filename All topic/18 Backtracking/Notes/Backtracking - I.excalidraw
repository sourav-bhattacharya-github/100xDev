    {
      "id": "sSF3ppCcMDVnCVkSFWvrD",
      "type": "text",
      "x": 398116.34134119324,
      "y": -179.16973094188273,
      "width": 739.1997680664062,
      "height": 1155,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#13171b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bR1",
      "roundness": null,
      "seed": 1398854387,
      "version": 773,
      "versionNonce": 529738045,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778600814373,
      "link": null,
      "locked": false,
      "text": "void f(int cur, int N, int K, vector<int> &path)\n{\n    \n    if(cur == N)\n    {\n        // print the path\n        return;\n    }\n\n    if(cur > N)\n    {\n        return;\n    }\n\n    for(int i = 1; i <= K; i++)\n    {\n        path.push_back(i);\n        f(cur + i, N, K, path);\n        path.pop_back();\n    }\n\n}\n\n\nmain()\n{\n    N = input();\n    K = input();\n\n    path = []\n\n    f(0, N, K, path);\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void f(int cur, int N, int K, vector<int> &path)\n{\n    \n    if(cur == N)\n    {\n        // print the path\n        return;\n    }\n\n    if(cur > N)\n    {\n        return;\n    }\n\n    for(int i = 1; i <= K; i++)\n    {\n        path.push_back(i);\n        f(cur + i, N, K, path);\n        path.pop_back();\n    }\n\n}\n\n\nmain()\n{\n    N = input();\n    K = input();\n\n    path = []\n\n    f(0, N, K, path);\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
