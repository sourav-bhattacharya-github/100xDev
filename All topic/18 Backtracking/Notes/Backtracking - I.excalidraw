      "isDeleted": false,
      "boundElements": [],
      "updated": 1778603352905,
      "link": null,
      "locked": false,
      "text": "f(idx, arr, path)\n{\n    if idx == arr.length:\n        // print path\n        return    \n\n    // Take\n    path.push_back(arr[idx]);\n    f(idx + 1, arr, path);\n    path.pop_back();   \n\n    // Not take\n    f(idx + 1, arr, path);\n}\n\n\nmain()\n{\n    N, Arr = input()\n    \n    path = []    \n\n    f(0, Arr, path)\n}\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(idx, arr, path)\n{\n    if idx == arr.length:\n        // print path\n        return    \n\n    // Take\n    path.push_back(arr[idx]);\n    f(idx + 1, arr, path);\n    path.pop_back();   \n\n    // Not take\n    f(idx + 1, arr, path);\n}\n\n\nmain()\n{\n    N, Arr = input()\n    \n    path = []    \n\n    f(0, Arr, path)\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
