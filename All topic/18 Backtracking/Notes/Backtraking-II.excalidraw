    {
      "id": "rFe55mlSYWkqpZVakW4VZ",
      "type": "text",
      "x": 450107.5398007121,
      "y": 1163.1255293687084,
      "width": 415.7998352050781,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
