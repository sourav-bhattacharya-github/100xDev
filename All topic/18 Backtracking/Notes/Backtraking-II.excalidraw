    {
      "id": "J8Dfj1fgKLYB0jHMMX6OD",
      "type": "text",
      "x": 452257.34696977626,
      "y": 1166.2383437354943,
      "width": 492.7998046875,
      "height": 560,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bpI",
      "roundness": null,
      "seed": 617187621,
      "version": 378,
      "versionNonce": 1548490635,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779209633668,
      "link": null,
      "locked": false,
      "text": "f(idx, sum):\n  \n    if sum == target:\n        print path\n        return\n    \n    if idx == N or sum > target:\n        return\n\n    // take\n    path.push_back(A[i])\n    f(idx, sum + A[i]);\n    path.pop_back()\n\n    // not take\n    f(idx + 1, sum)",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(idx, sum):\n  \n    if sum == target:\n        print path\n        return\n    \n    if idx == N or sum > target:\n        return\n\n    // take\n    path.push_back(A[i])\n    f(idx, sum + A[i]);\n    path.pop_back()\n\n    // not take\n    f(idx + 1, sum)",
      "autoResize": true,
      "lineHeight": 1.25
    },
