      "seed": 1160804427,
      "version": 235,
      "versionNonce": 1938871749,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779209141893,
      "link": null,
      "locked": false,
      "text": "f(idx, sum):\n    \n    if idx == N:\n        if sum == target:\n            print path\n        return\n        \n\n    // take\n    path.push_back(A[i])\n    f(idx + 1, sum + A[i]);\n    path.pop_back()\n\n    // not take\n    f(idx + 1, sum)",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(idx, sum):\n    \n    if idx == N:\n        if sum == target:\n            print path\n        return\n        \n\n    // take\n    path.push_back(A[i])\n    f(idx + 1, sum + A[i]);\n    path.pop_back()\n\n    // not take\n    f(idx + 1, sum)",
      "autoResize": true,
      "lineHeight": 1.25
    },
