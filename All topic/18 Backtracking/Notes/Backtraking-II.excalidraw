      "isDeleted": false,
      "boundElements": [],
      "updated": 1779206207143,
      "link": null,
      "locked": false,
      "text": "f(s, idx):\n\n    if idx == s.size():\n        print path\n        return\n\n    char digit = s[idx]\n    \n    string choices = keypad[digit];\n\n    for(char ch : choices)\n    {\n        path.push_back(ch);\n        f(s, idx + 1, path);\n        path.pop_back();\n    }\n\n\n    ",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "f(s, idx):\n\n    if idx == s.size():\n        print path\n        return\n\n    char digit = s[idx]\n    \n    string choices = keypad[digit];\n\n    for(char ch : choices)\n    {\n        path.push_back(ch);\n        f(s, idx + 1, path);\n        path.pop_back();\n    }\n\n\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
